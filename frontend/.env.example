# Backend (Express app in /backend). REQUIRED in production — forms fail without it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# AI chatbot (/api/chat)
OPENROUTER_API_KEY=

# /analytics dashboard login. REQUIRED — the dashboard returns 503 if unset.
ANALYTICS_USER=
ANALYTICS_PASS=
# Optional salt for hashing visitor IDs (raw IPs are never stored)
ANALYTICS_SALT=

# Persistent analytics storage — set ONE pair (Upstash Redis or Vercel KV).
# Without these, analytics live in memory and reset on every cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
